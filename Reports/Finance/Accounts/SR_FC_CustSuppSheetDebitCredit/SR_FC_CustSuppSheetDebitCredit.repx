                    <Item1 Ref="493" EventName="BeforePrint" PropertyName="TextAlignment" Expression="Iif(?IsRTL == True, 'MiddleLeft', 'MiddleRight')&#xA;&#xA;&#xA;&#xA;" />
                    <Item2 Ref="494" EventName="BeforePrint" PropertyName="Text" Expression="Iif(&#xD;&#xA;    (SumRunningSum([Result]) + (sumDSum([OpenResult]))) &gt; 0, (SumRunningSum([Result]) + (sumDSum([OpenResult]))) , &#xD;&#xA;    0&#xD;&#xA;)&#xD;&#xA;" />
                  </ExpressionBindings>
                  <StylePriority Ref="495" UseFont="false" UseBorderWidth="false" />
                </Item4>
                <Item5 Ref="496" ControlType="XRTableCell" Name="xrTableCell49" Multiline="true" TextAlignment="MiddleRight" BorderWidth="1.4">
                  <Summary Ref="497" Running="Group" />
                  <ExpressionBindings>
                    <Item1 Ref="498" EventName="BeforePrint" PropertyName="TextAlignment" Expression="Iif(?IsRTL == True, 'MiddleLeft', 'MiddleRight')&#xA;&#xA;&#xA;" />
                    <Item2 Ref="499" EventName="BeforePrint" PropertyName="Text" Expression="Iif(&#xD;&#xA;     (SumRunningSum([Result]) + (sumDSum([OpenResult])))  &lt;0,&#xD;&#xA;    Abs((SumRunningSum([Result]) + (sumDSum([OpenResult])))  ), &#xD;&#xA;    0&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;" />
                  </ExpressionBindings>
                  <StylePriority Ref="500" UseFont="false" UseBorderWidth="false" UseTextAlignment="false" />
                </Item5>
              </Cells>
            </Item1>
          </Rows>
          <StylePriority Ref="501" UseBorders="false" />
        </Item1>
      </Controls>
