                    <Item2 Ref="526" EventName="BeforePrint" PropertyName="Text" Expression="sumSum([MoveValueForeign])+sumDSum(IsNull([OpenBalanceForeign],0 ))" />
                  </ExpressionBindings>
                  <StylePriority Ref="527" UseFont="false" UseBorderWidth="false" />
                </Item3>
