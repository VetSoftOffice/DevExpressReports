                    <Item2 Ref="565" EventName="BeforePrint" PropertyName="Text" Expression="Iif(&#xA;    [SupplierCurrencyCount] &gt; 1,&#xA;    sumSum([MoveValue]) + sumDSum(IsNull([OpenBalance], 0)),&#xA;    ''&#xA;)" />
                  </ExpressionBindings>
                  <StylePriority Ref="566" UseFont="false" UseBorderWidth="false" UseTextAlignment="false" />
