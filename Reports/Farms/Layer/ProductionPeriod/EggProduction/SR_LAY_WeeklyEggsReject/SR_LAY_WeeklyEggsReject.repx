              <ReportSource Ref="218" ControlType="DevExpressReports.Reports.Farms.Layer.ProductionPeriod.EggProduction.SR_LAY_WeeklyEggsReject1.SR_LAY_WeeklyEggsReject1, DevExpressReports, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" ScriptsSource="&#xD;&#xA;decimal totalProductionSum = 0;&#xD;&#xA;decimal totalRejectedSum = 0;&#xD;&#xA;decimal mobaSum = 0;&#xD;&#xA;&#xD;&#xA;private void xrTableCell21_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    XRTableCell cell = sender as XRTableCell;&#xD;&#xA;&#xD;&#xA;    decimal totalProduction = Convert.ToDecimal(GetCurrentColumnValue(&quot;TotalProduction&quot;));&#xD;&#xA;    decimal totalRejected   = Convert.ToDecimal(GetCurrentColumnValue(&quot;TotalRejectedEggs&quot;));&#xD;&#xA;&#xD;&#xA;    if (totalProduction != 0)&#xD;&#xA;    {&#xD;&#xA;        cell.Text = ((totalRejected / totalProduction) * 100).ToString(&quot;N2&quot;);&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        cell.Text = &quot;0.00&quot;;&#xD;&#xA;    }&#xD;&#xA;    totalProductionSum += totalProduction ;&#xD;&#xA;    totalRejectedSum += totalRejected  ;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void xrTableCell14_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    XRTableCell cell = sender as XRTableCell;&#xD;&#xA;&#xD;&#xA;    decimal totalProduction = Convert.ToDecimal(GetCurrentColumnValue(&quot;TotalProduction&quot;));&#xD;&#xA;    decimal totalRejected   = Convert.ToDecimal(GetCurrentColumnValue(&quot;TotalRejectedEggs&quot;));&#xD;&#xA;    decimal moba            = Convert.ToDecimal(GetCurrentColumnValue(&quot;MOBA&quot;));&#xD;&#xA;&#xD;&#xA;    decimal totalRejWithMoba = totalRejected + moba;&#xD;&#xA;&#xD;&#xA;    if (totalProduction != 0)&#xD;&#xA;    {&#xD;&#xA;        cell.Text = ((totalRejWithMoba / totalProduction) * 100).ToString(&quot;N2&quot;);&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        cell.Text = &quot;0.00&quot;;&#xD;&#xA;    }&#xD;&#xA;    totalProductionSum += totalProduction ;&#xD;&#xA;    totalRejectedSum += totalRejected  ;&#xD;&#xA;    mobaSum += moba;&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void xrTableCell27_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;        XRTableCell cell = sender as XRTableCell;&#xD;&#xA;        if (totalProductionSum != 0)&#xD;&#xA;        {&#xD;&#xA;            cell.Text = ((totalRejectedSum / totalProductionSum) * 100).ToString(&quot;N2&quot;);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void xrTableCell35_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    decimal result = totalRejectedSum + mobaSum &#xD;&#xA;    &#xD;&#xA;    if (totalProductionSum != 0)&#xD;&#xA;    {&#xD;&#xA;        cell.Text = ((result / totalProductionSum ) * 100).ToString(&quot;N2&quot;);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;" Landscape="true" PageWidthF="1169.29138" PageHeightF="826.771667" Version="26.1" DataMember="SR_LAY_WeeklyEggsReject1" DataSource="#Ref-217" TextAlignment="MiddleLeft" BorderColor="255,75,75,75" Borders="All" BorderWidth="0.5">
