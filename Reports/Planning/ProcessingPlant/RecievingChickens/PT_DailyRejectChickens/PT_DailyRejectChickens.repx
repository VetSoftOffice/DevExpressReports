    <Item7 Ref="17" Name="PuckRejectPer_GT" Expression="Iif(&#xA;  Sum([SR_PT_DailyRecePlucking.CounterTotal]) &gt; 0,&#xA;  Sum([SR_PT_DailyRecePlucking.PluckReject]) / Sum([SR_PT_DailyRecePlucking.CounterTotal]) * 100,&#xA;  0&#xA;)&#xA;" DataMember="SR_PT_DailyRecePlucking" />
    <Item8 Ref="18" Name="DOA_GT" Expression="Iif(&#xA;  Sum([SR_PT_DailyRecePlucking.CounterTotal]) &gt; 0,&#xA;  Sum([SR_PT_DailyRecePlucking.DOA]) % Sum([SR_PT_DailyRecePlucking.CounterTotal]),&#xA;  0&#xA;)&#xA;" DataMember="SR_PT_DailyRecePlucking" />
    <Item9 Ref="19" Name="Culls_GT" Expression="Iif(&#xA;  Sum([SR_PT_DailyRecePlucking.CounterTotal]) &gt; 0,&#xA;  Sum([SR_PT_DailyRecePlucking.Culls]) / Sum([SR_PT_DailyRecePlucking.CounterTotal]) * 100,&#xA;  0&#xA;)&#xA;" DataMember="SR_PT_DailyRecePlucking" />
